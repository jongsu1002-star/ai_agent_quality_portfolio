# Example environment variables for Docker deployment

# 로그인은 환경변수가 아니라 회원가입(/signup)으로 켜집니다: 계정이 하나도 없으면(기본값,
# LAN 내부용) 인증 없이 동작하고, 누군가 처음 가입하는 순간 그 계정이 자동으로 승인된
# 관리자가 되며 그때부터 전체 로그인이 강제됩니다. 승인해줄 관리자가 없어졌을 때만
# `python scripts/create_admin.py <아이디>`로 비상 관리자 계정을 만드세요.
# (자세한 내용은 docs/사용자_매뉴얼.md 2.2장 참고)

# 공개 도메인에 배포할 때만 설정하세요: 계정이 하나도 없는 배포 직후 틈을 타 외부인이
# 먼저 가입해 관리자를 선점하는 것을 막기 위한 값입니다. 값을 채워두면 서비스 최초
# 가입 시 가입 화면에 "관리자 설정 코드" 입력란이 나타나고, 이 값을 아는 사람만 자동
# 관리자가 될 수 있습니다. 비워두면(기본값, LAN 내부용) 기존과 동일하게 동작합니다.
ADMIN_SETUP_CODE=

SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
TEAMS_WEBHOOK_URL=
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_TOKEN=
JIRA_PROJECT=

# LLM judge / rubric / groundedness+regression LLM-side scoring.
# Without this, those checks are skipped (errored=True) rather than failing the run.
# Pick ONE provider via LLM_PROVIDER (openai / anthropic / custom / none, default openai).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# 모니터링 애드온(k6 성능테스트 이력 / SQLite / Prometheus·Grafana) feature flag.
# 값을 비워두거나 지우면 기본값 true(켜짐)로 동작합니다. 문제가 생기면 아래를 false로
# 바꾸고 서버를 재시작하세요 - 애드온만 꺼지고 기존 플랫폼은 그대로 동작합니다.
# (자세한 내용은 README.md, docs/사용자_매뉴얼.md 11장 참고)
MONITORING_ADDON_ENABLED=true
K6_HISTORY_ENABLED=true
MONITORING_ADDON_DB_ENABLED=true
PROMETHEUS_ADDON_ENABLED=true
GRAFANA_LINK_ENABLED=true

# Grafana/Prometheus를 인터넷에 3000/9090 포트로 직접 열지 않고, 이 앱의 로그인 +
# 관리자 화면의 "접근 허용 IP" 목록을 거쳐 /grafana-proxy, /prometheus-proxy 경로로만
# 접근하게 하려면(AWS 등 공개 배포 시 권장) 아래를 설정하세요.
# - GRAFANA_ROOT_URL: Grafana가 서브패스로 서빙되도록 하는 실제 공개 주소.
#   비워두면 로컬 기본값(http://localhost/grafana-proxy/) 사용 - AWS 등 공개 배포 시
#   실제 도메인으로 바꾸세요(예: https://your-domain.com/grafana-proxy/).
# - GRAFANA_INTERNAL_URL / PROMETHEUS_INTERNAL_URL: 이 앱(qa-platform 컨테이너)이
#   Grafana/Prometheus 컨테이너에 접근할 내부 주소. 같은 docker-compose.yml로 함께
#   띄우면 기본값(http://grafana:3000, http://prometheus:9090)을 그대로 쓰면 되고,
#   앱을 로컬 uvicorn으로 별도 실행한 경우(infra/docker-compose.monitoring.yml 사용
#   시)에만 http://localhost:3000 / http://localhost:9090 으로 바꿔주세요.
GRAFANA_ROOT_URL=
GRAFANA_INTERNAL_URL=
PROMETHEUS_INTERNAL_URL=
